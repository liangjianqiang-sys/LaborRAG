# ================================
# LaborRAG 环境变量配置
# ================================
# 复制此文件为 .env 并填入实际值

# LLM配置（必填）
# 支持 百炼/DeepSeek/GLM-4/OpenAI 等兼容API
LLM_API_KEY=your_api_key_here
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen3.7-max-2026-05-20
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# 评估用LLM配置（可选，不填则与生成用相同）
# 推荐用Plus级别模型做评估，节省额度
EVAL_LLM_API_KEY=
EVAL_LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
EVAL_LLM_MODEL_NAME=qwen3.6-plus

# Embedding配置（默认使用BGE-M3本地模型，无需填API Key）
# 如果想用百炼Embedding API，填写以下两项：
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=

# 向量库与数据配置
# VECTOR_STORE_PATH 和 DATA_DIR 不需要配置，使用 config.py 中的默认值
# FAISS不支持中文路径，向量库默认存到 D:/LaborRAG_data/vector_store
CHUNK_SIZE=800
CHUNK_OVERLAP=100
CHUNK_STRATEGY=law_article  # recursive(固定长度) | law_article(法条结构化)

# 检索配置
RETRIEVER_TYPE=reranked  # vector(V1) | hybrid(V2混合) | reranked(V2重排序)
TOP_K=8
SCORE_THRESHOLD=0.2

# 混合检索配置 (V2, RETRIEVER_TYPE=hybrid或reranked时生效)
VECTOR_WEIGHT=0.5
BM25_WEIGHT=0.5
RRF_K=60

# 重排序配置 (V2, RETRIEVER_TYPE=reranked时生效)
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
RERANK_TOP_K=5

# RAG模式配置 (V3/V4)
RAG_MODE=agent  # simple(V1/V2简单链路) | crag(V3自我纠错) | agent(V4多Agent协作，推荐)
