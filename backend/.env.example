# ================================
# LaborRAG 环境变量配置
# ================================
# 复制此文件为 .env 并填入实际值

# 访问鉴权（可选）
# 留空 = 不启用鉴权，本地开发零配置即可访问所有接口。
# 填值后，除 /health 外的所有 API 端点都要求 Authorization: Bearer <AUTH_SECRET>，
# 前端需在「设置 → 访问鉴权」页填入同一个值。
# 生成强随机串：python -c "import secrets;print(secrets.token_urlsafe(32))"
AUTH_SECRET=

# ─── 三个 LLM 槽位 ────────────────────────────────────────────────
# 本项目共 3 个 LLM 槽位，用途与调用量差别很大，**不要三个都用同一个模型**：
#
#   槽位                  用途                          每问题调用次数   选型侧重
#   LLM_MODEL_NAME        生成主答案                    1              质量
#   EVAL_LLM_MODEL_NAME   改写/路由/HyDE/多查询/充分性   5–6            速度+成本+结构化输出
#   RAGAS_MODEL_NAME      RAGAS 三元组评判              评估时大量      评判可靠性
#
# ⚠️ 硬性约束：所有调用都传 `extra_body={"enable_thinking": False}`，
#    因为辅助槽要的是「一个词」「JSON」「充分/不足」这类短结构化输出。
#    因此**强制开启思考、无法关闭的模型不要用在辅助槽**（如 glm-5.3-flash：
#    实测延迟 9–29s、额外产生 616–2138 个隐藏思考 token）。

# 生成模型（必填）——1 次/问题，质量优先
# 百炼文档明确点名 qwen3.8-max 适用于「法律、金融、设计」等专业任务
LLM_API_KEY=your_api_key_here
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen3.8-max
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# 辅助/评估模型（可选，不填则与生成用相同）
# 调用量是生成槽的 5–6 倍，务必选便宜且快的；qwen3.8-flash 价格约为 max 的 1/15
EVAL_LLM_API_KEY=
EVAL_LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
EVAL_LLM_MODEL_NAME=qwen3.8-flash

# RAGAS 评判模型（可选，不填则与 EVAL_LLM 相同）
# 建议换一个**模型家族**做评判（生成用 qwen、评判用 deepseek），可减少自偏好偏差：
# 同族模型给自己生成的答案打分往往偏乐观
RAGAS_API_KEY=
RAGAS_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
RAGAS_MODEL_NAME=deepseek-v4.1-flash

# Embedding配置（默认使用BGE-M3本地模型，无需填API Key）
# 如果想用百炼Embedding API，填写以下两项：
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=

# 向量库与数据配置
# 运行时数据目录（向量库、对话历史、评估数据默认存于此目录下）
# FAISS不支持中文路径，若项目路径含中文需通过此变量指定纯英文路径
RUNTIME_DATA_DIR=
# VECTOR_STORE_PATH 和 DATA_DIR 不需要配置，使用 config.py 中的默认值
CHUNK_SIZE=800
CHUNK_OVERLAP=100
CHUNK_STRATEGY=law_article  # recursive(固定长度) | law_article(法条结构化)
PARENT_CHILD_ENABLED=true

# 检索配置
RETRIEVER_TYPE=reranked  # vector(纯向量) | hybrid(混合检索) | reranked(重排序检索，推荐)
TOP_K=8
SCORE_THRESHOLD=0.2

# 混合检索配置 (RETRIEVER_TYPE=hybrid或reranked时生效)
VECTOR_WEIGHT=0.5
BM25_WEIGHT=0.5
RRF_K=60

# 重排序配置 (RETRIEVER_TYPE=reranked时生效)
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
RERANK_TOP_K=5

# 检索验证配置（两步生成开关）
RETRIEVAL_VALIDATION=false  # true(开启grader验证) | false(跳过验证直接生成，推荐)

# 评估配置
EVAL_MAX_CONCURRENT=2  # 评估答案生成并发度（API限流时降低）
EVAL_TASK_TIMEOUT=1800  # 评估任务超时秒数（默认30分钟）

# HuggingFace镜像源（国内加速）
HF_ENDPOINT=https://hf-mirror.com

# HuggingFace 模型缓存目录（bge-m3 约 2.2GB + 重排模型约 2.2GB）
#
# ⚠️ 为什么不能留在默认位置：
#   默认路径是 C:\Users\<用户>\.cache\huggingface，而 `.cache` 是清理软件
#   （360 / 电脑管家 / Windows 存储感知）的常见清理目标。本项目实测被整体
#   清空过一次，约 8GB 模型缓存消失 —— 表现为**启动时静默重新下载**，
#   或离线环境下直接起不来。放到非系统盘、目录名不含 `.cache` 可避开。
#
# ⚠️ 生效时机（这一条最容易踩）：
#   该值由 app/core/config.py 在**模块体**中写入 os.environ。
#   huggingface_hub 在 import 时就把 HF_HOME 固化成了模块级常量
#   (constants.HF_HUB_CACHE)，之后再设置**是无效的** —— 不报错，
#   只是模型照样下到 C 盘。所以不要在别的模块里重复设置这一项。
HF_HOME=D:/hf_cache
